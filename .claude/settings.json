{
  "permissions": {
    "deny": [
      "Read(./dist/**)",
      "Read(./build/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/scope_guard.py\"",
            "statusMessage": "Checking domain file scope..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "miro@claude-plugins-official": true
  }
}
