      "revert_on": "panel_closed",
      "revert_to": "highlight_tutorial_flute_tile"
    },
    {
      "advance_on": "panel_closed",
      "allow": [],
      "flags": {
        "banner": "close_panel_hint"
      },
      "highlight": [
        "button:close"
      ],
      "id": "highlight_close_panel_hint",
      "message": null,
      "revert_on": null,
      "revert_to": null
    },
    {
      "advance_on": "end_turn",
      "allow": [
        "button:end_turn"
      ],
      "flags": {},
      "highlight": [
        "button:end_turn"
      ],
      "id": "highlight_end_turn_button",
      "message": null,
      "revert_on": null,
      "revert_to": null
    },
    {
      "advance_on": "round_end",
      "allow": [],
