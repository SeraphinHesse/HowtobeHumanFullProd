{
  "first_loss_costs_life": true,
  "messages": {
    "close_panel_hint": "right click anywhere to close",
    "economy_intro": "You need love to create. In order for you to gain Love, you need economy buildings",
    "lives_intro": "Once the humans reach our hole the round is lost. You have only 3 lives. If economy buildings get destroyed during the human attack they don't yield resources. To defend your base you need to build defense buildings"
  },
  "skippable": true,
  "steps": [
    {
      "advance_on": "message_dismissed:economy_intro",
      "allow": [
        "dismiss_message",
        "skip_tutorial"
      ],
      "flags": {},
      "highlight": [],
      "id": "economy_message",
      "message": "economy_intro",
      "revert_on": null,
      "revert_to": null
    },
    {
      "advance_on": "tile_clicked:tutorial_flute",
      "allow": [
        "tile_click:tutorial_flute"
      ],
      "flags": {},
      "highlight": [
        "tile:tutorial_flute"
      ],
      "id": "highlight_tutorial_flute_tile",
      "message": null,
      "revert_on": null,
      "revert_to": null
    },
    {
      "advance_on": "building_selected:economic",
      "allow": [
        "card_select:economic"
      ],
      "flags": {},
      "highlight": [
        "card:economic"
      ],
      "id": "highlight_musician_card",
      "message": null,
      "revert_on": "panel_closed",
      "revert_to": "highlight_tutorial_flute_tile"
    },
    {
      "advance_on": "building_placed:economic",
      "allow": [
        "button:confirm"
      ],
      "flags": {},
