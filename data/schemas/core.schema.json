  "$id": "core.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Core balancing domain (D-10), REPLAN nested tree (Phase 9A): camera, general, phase loop, XP, the hole, lightning strike, debug-mode telemetry. Values are the prototype's live tuning, verbatim. Bounds policy: fractions 0-1, costs/counts 0-10000, rounds/levels 0-1000, seconds 0-60, camera zoom factors 0.1-100.",
  "properties": {
    "Camera": {
      "additionalProperties": false,
      "description": "Camera zoom and travel limits (E-5). Overrides geometry.json's zoom_levels/default fallback at load time (engine/coords/__init__.py::load_coordinate_system) so zoom is a designer-editable balancing tunable, not baked into geometry.json.",
      "properties": {
        "default_zoom": {
          "description": "Zoom factor the camera opens at. Must be a member of zoom_levels (cross-field check enforced at load time via CoordinateSystem.set_zoom, not expressible in schema).",
          "maximum": 100,
          "minimum": 0.1,
          "type": "number"
        },
        "keyboard_pan_speed": {
          "description": "How fast W/A/S/D and the arrow keys pan the camera, in SCREEN pixels per second - zoom-independent, matching mouse-drag panning's own raw-pixel behaviour (a drag never scales by zoom either), so holding a movement key feels exactly as responsive at any zoom level.",
          "maximum": 4096,
          "minimum": 1,
          "type": "number"
        },
        "max_offset_tiles_x": {
          "description": "How far the camera may travel horizontally from the map's camera start point, in TILES (grid steps; zoom-independent, so the same distance at every zoom level). Bounds the viewport CENTRE, so roughly half a screen beyond the limit is still visible. The map bounds still apply on top of it, whichever is tighter. 0 = unlimited (the shipped default: free roam within the map).",
          "maximum": 1024,
          "minimum": 0,
          "type": "number"
        },
        "max_offset_tiles_y": {
          "description": "How far the camera may travel vertically from the map's camera start point, in TILES (grid steps; zoom-independent, so the same distance at every zoom level). Bounds the viewport CENTRE, so roughly half a screen beyond the limit is still visible. The map bounds still apply on top of it, whichever is tighter. 0 = unlimited (the shipped default: free roam within the map).",
          "maximum": 1024,
          "minimum": 0,
          "type": "number"
        },
        "zoom_levels": {
          "description": "The discrete camera zoom factors the wheel steps through, ascending.",
          "items": {
            "description": "One discrete zoom factor.",
            "maximum": 100,
            "minimum": 0.1,
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "default_zoom",
        "keyboard_pan_speed",
        "max_offset_tiles_x",
        "max_offset_tiles_y",
        "zoom_levels"
      ],
      "type": "object"
    },
    "Debug": {
      "additionalProperties": false,
      "description": "Debug-mode run telemetry (game/debug) and the main-menu entry points that arm it. These gate which run modes the menu offers and what a debug run captures by default; they never change gameplay balance.",
      "properties": {
        "ask_player_identity": {
          "description": "Ask for a player name + experience level before a debug run starts; stamps them into the log filenames and reports.",
          "type": "boolean"
        },
        "debug_mode_available": {
