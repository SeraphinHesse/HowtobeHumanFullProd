{
  "$defs": {
    "enemy_intro_entry": {
      "additionalProperties": false,
      "description": "One designer-authored enemy/boss introduction dialogue: which round it pops up on, what it says, and which existing enemy sprite slot it shows enlarged. Two entries may share the same round (they queue and show one after another).",
      "properties": {
        "anim_speed": {
          "description": "Multiplier on the window's own animation clock before it is converted to playback time. 1.0 is normal speed; 0 freezes on the loop's first frame; no negative/reverse playback.",
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        },
        "animation": {
          "description": "Named animation row (from the sprite_slot's own manifest entry) to loop for the full time the window is visible. Falls back to idle at runtime if the slot has no such row (Manifest.current_frame's existing tolerance) -- a value from the wrong category's vocabulary is harmless, not a data error.",
          "enum": [
            "attack",
            "death",
            "dig",
            "disabled",
            "edge_ne",
            "edge_nw",
            "edge_se",
            "edge_sw",
            "emerge",
            "hover",
            "hurt",
            "idle",
            "kidnap",
            "place",
            "pressed",
            "upgrade",
            "walk"
          ],
          "type": "string"
        },
        "background_tint": {
          "description": "[r, g, b, a] color wash drawn behind the sprite, matching its box, before the sprite itself. a == 0 means no visible overlay -- the whole array still round-trips at its [0,0,0,0] default so the generic balancing panel never needs a nullable-field case.",
          "items": {
            "description": "One 0-255 RGBA channel.",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "body": {
          "description": "The flavor/stat text shown below the title, word-wrapped in the panel. Free text, not auto-generated from live enemy stats.",
          "maxLength": 2000,
          "minLength": 0,
          "type": "string"
        },
        "crop_h": {
          "description": "Source sub-rect height, in the sprite's own frame pixels. 0 together with crop_w == 0 means no crop (draw the whole frame, scaled to sprite_w/sprite_h) -- the fit_tiles == 0 sentinel convention.",
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        "crop_w": {
          "description": "Source sub-rect width, in the sprite's own frame pixels. 0 together with crop_h == 0 means no crop (draw the whole frame, scaled to sprite_w/sprite_h) -- the fit_tiles == 0 sentinel convention.",
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        "crop_x": {
          "description": "Source sub-rect left, in the sprite's own frame pixels. Only meaningful when crop_w/crop_h declare a real crop.",
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        "crop_y": {
          "description": "Source sub-rect top, in the sprite's own frame pixels. Only meaningful when crop_w/crop_h declare a real crop.",
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        "enemy_label": {
          "description": "Designer-facing label for this entry (e.g. 'Raider' or 'Boss (Era 2)') — for your own bookkeeping in the editor only, never cross-checked against enemies.json's EnemyTypes keys.",
          "maxLength": 80,
          "minLength": 0,
          "type": "string"
        },
        "hidden_frames": {
          "description": "Extra frame-column indices to skip during playback for THIS entry, unioned with (never overriding) whatever hidden columns the sprite_slot's manifest row already bakes in for that animation.",
          "items": {
            "description": "A frame column index to skip.",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array",
          "x-array-editable": true
        },
        "round": {
          "description": "The round number this dialogue pops up on, at the very start of the attacking (ENEMY) phase. Independent of the enemy's own start_round in enemies.json — set it to whatever round you want the story beat to land on.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "sprite_flip_h": {
          "description": "Mirrors the sprite horizontally.",
          "type": "boolean"
        },
        "sprite_h": {
          "description": "Height in pixels of the sprite box drawn inside the panel.",
          "maximum": 2048,
          "minimum": 8,
          "type": "integer"
        },
        "sprite_offset_x": {
          "description": "Pixel nudge of the sprite's dest box horizontally, off its default centered position.",
          "maximum": 4096,
          "minimum": -4096,
          "type": "integer"
        },
        "sprite_offset_y": {
          "description": "Pixel nudge of the sprite's dest box vertically, off its default centered position.",
          "maximum": 4096,
          "minimum": -4096,
          "type": "integer"
        },
        "sprite_slot": {
          "description": "Which existing sprite slot (data/slots.json, ANY category) to draw enlarged in this panel -- not limited to enemy art. Regenerate this enum with tools/gen_sprite_slot_enum.py after adding a slot in data/slots.json.",
