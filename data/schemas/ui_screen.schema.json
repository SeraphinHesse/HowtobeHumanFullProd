{
  "$id": "https://example.com/schemas/ui_screen.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "background": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "slot": {
              "type": "string"
            }
          },
          "required": [
            "slot"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "color": {
              "items": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 3,
              "type": "array"
            }
          },
          "required": [
            "color"
          ]
        }
      ],
      "type": "object"
    },
    "defaults": {
      "additionalProperties": false,
      "properties": {
        "button_skin": {
          "type": "string"
        },
        "font": {
          "type": "string"
        },
        "panel_skin": {
          "type": "string"
        },
        "text_color": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 3,
          "type": "array"
        }
      },
      "type": "object"
    },
    "widgets": {
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "additionalProperties": false,
          "properties": {
            "color": {
              "items": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 3,
              "type": "array"
            },
            "font": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "parent": {
              "description": "Designer re-parenting (authoring metadata the game never reads): the widget id this widget hangs off in the editor's outliner, overriding screen_defaults.json's own `parent`. Explicit null re-roots a widget whose default parent the designer rejected — distinct from the key being ABSENT, which keeps the default. A cyclic or dangling chain resolves to root in the editor rather than failing.",
              "type": [
                "string",
                "null"
              ]
            },
            "rect": {
              "items": {
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            "skin": {
              "type": "string"
            },
            "text_color": {
              "items": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 3,
              "type": "array"
            },
            "text_id": {
              "minLength": 1,
              "type": "string"
            },
            "tint": {
              "items": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 3,
              "type": "array"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "type": "object"
}
