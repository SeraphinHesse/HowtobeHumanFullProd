{
  "$id": "https://example.com/schemas/ui_screen.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "background": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "slot": {
              "type": "string"
            }
          },
          "required": [
            "slot"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "color": {
              "items": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 3,
              "type": "array"
            }
          },
          "required": [
            "color"
          ]
        }
      ],
      "type": "object"
    },
    "custom_widgets": {
      "additionalProperties": false,
      "description": "Designer-AUTHORED widgets that exist only in this file: a hand-written twin of ONE screen_defaults.json widget entry, for decoration a designer wants and no code owns. This entry is the widget's DEFAULT GEOMETRY ONLY. Everything paintable -- skin, color, label, text_id, font, text_color, tint, align, visible, parent, layers, states -- is an ORDINARY override under widgets/<the same id>, exactly as for a code-owned widget; there is no second styling vocabulary here. The game draws these at the tail of the two submit_layers calls every screen already makes, so a screen with no custom_widgets emits not one extra primitive. Custom widgets are NEVER click targets: neither the widget nor its layers are hit-tested, and a click passes straight through to the real UI underneath. parent on a custom widget is authoring-only metadata the game never reads.",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "additionalProperties": false,
          "properties": {
            "band": {
              "description": "Which of the screen's two layer passes draws it: \"under\" (behind EVERYTHING on the screen -- the HUD pass has no depth sort) or \"over\" (in front of everything). Absent means \"under\", the opposite of an undecorated LAYER entry, which defaults to \"over\": a custom widget is decoration a designer invented, and defaulting it on top of the screen's own readouts and buttons hides the game. The editor writes this key explicitly on creation.",
              "enum": [
                "under",
                "over"
              ]
            },
            "display_name": {
              "description": "Authoring-only label for the editor's outliner, so a designer reads something friendlier than a raw id. The game never reads it.",
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "description": "What the widget draws before its own layers. \"panel\": skin (falling back to this screen's defaults.panel_skin) as a sprite, else color as a rect -- and THEN a centred label/text_id on top when one is set, so a panel may emit two primitives. \"backdrop\": the same box, no text and no kind-matched default (its own skin only). \"label\": text only, no box. An empty resolved string draws nothing, never a blank text item.",
              "enum": [
                "panel",
                "label",
                "backdrop"
              ]
            },
            "rect": {
              "description": "The widget's DEFAULT [x, y, w, h] in screen pixels -- its creation geometry, standing in for what screen_defaults.json holds for a code-owned widget. A rect under widgets/<the same id> still wins over it, so a designer moves a custom widget down the ordinary override path like every other widget.",
              "items": {
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            "view": {
              "description": "Restrict this custom widget to ONE of the screen's VIEWS (screen_defaults.json's `views` keys -- `construct`, `unlock`, `upgrade`, `base_info`, `preview` on building_panel). ABSENT means every view, which is what a single-view screen wants and what this key meant before it existed. A screen id is shared by every MODE of its panel and by the modals that declare it, so an unscoped custom widget -- drawn off the screen id alone at the tail of submit_layers -- appears in all of them at once; naming a view is how a designer says \"this decoration belongs to the build list\", not \"to the building panel\". The editor stamps whichever view was open when the widget was created and lets you change it; the game filters on the view its own submit() passes in, and a screen that passes none draws every custom widget regardless.",
              "minLength": 1,
              "type": "string"
            },
            "z": {
              "description": "Paint order among the custom widgets of the SAME band, ascending; absent means 0. It orders custom widgets against each other only -- never against the screen's own code-owned widgets, which the band alone decides.",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "rect"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "defaults": {
      "additionalProperties": false,
      "properties": {
        "button_skin": {
          "type": "string"
        },
        "font": {
          "type": "string"
        },
        "panel_skin": {
          "type": "string"
        },
        "price_is_click_target": {
          "description": "building_panel only. When true, ONLY a construct card's price button opens the construct preview and the portrait/name go inert; when false or absent (the default), the whole card is the click target as it always was and the price button is drawn but never hit-tested.",
          "type": "boolean"
        },
        "text_color": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 3,
          "type": "array"
        },
        "use_card_portrait_slot": {
          "description": "building_panel only. When true, a construct card's portrait draws the dedicated card_portrait_<building_type> art family (data/slots.json's ui -> Card Portraits), falling back to the building's own tier sprite whenever that slot has no imported art. When false or absent (the default), the portrait is always the tier sprite.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "widgets": {
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "additionalProperties": false,
          "properties": {
            "align": {
              "description": "Which way the widget's text spreads from its stored anchor x — the same three values game/ui/widgets.submit_label already reads off the holder. Absent means \"left\", submit_label's own fallback, so a screen doc that predates this key draws unchanged.",
              "enum": [
                "left",
                "center",
                "right"
              ],
              "type": "string"
            },
            "band": {
              "description": "RELOCATE this CODE-OWNED widget out of the screen's own draw and into one of the two layer passes (UL-14): \"under\" (behind EVERYTHING the screen draws) or \"over\" (in front of everything), where it sorts by `z` against the custom widgets of that band. ABSENT is the normal case and means \"not banded\" -- the screen draws the widget itself, exactly where its own submit() always did; there is no default band for a code-owned widget. Honoured only for kind panel | backdrop | label (a banded widget is drawn generically from its AUTHORED appearance, and button/bar/field have no generic draw); on any other kind it is ignored and the widget draws normally. A banded widget is INERT: like a custom widget it is no longer hit-tested, and a click passes through to whatever is under it. On a CUSTOM widget id this key is ignored -- custom_widgets/<id>'s own band is what places it.",
              "enum": [
                "under",
                "over"
              ]
            },
            "color": {
              "items": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
