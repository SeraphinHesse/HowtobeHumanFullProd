{
  "$defs": {
    "widget": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "description": "Horizontal anchor of the widget's text relative to rect[0] — recorded only when the widget carries an `align` attribute other than the 'left' default. The editor needs it to place the hit box of a POSITION-ONLY text anchor (rect w/h 0), whose drawn extent spreads left/both ways from the stored x.",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "type": "string"
        },
        "font_key": {
          "description": "The engine font preset (data/ui/fonts.json key) the widget draws its text at, when it carries one. Recorded so the editor can MEASURE a position-only text anchor at the right size instead of guessing 'md'.",
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "button",
            "panel",
            "label",
            "backdrop",
            "bar",
            "field"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "rect": {
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "sample": {
          "type": "string"
        },
        "text_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "rect",
        "kind",
        "label"
      ],
      "type": "object"
    }
  },
  "$id": "https://example.com/schemas/screen_defaults.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "additionalProperties": false,
      "properties": {
        "mock_note": {
          "type": "string"
        },
        "views": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "additionalProperties": false,
              "properties": {
                "mock_note": {
                  "type": "string"
                },
                "widgets": {
                  "additionalProperties": false,
                  "patternProperties": {
                    "^[a-z][a-z0-9_]*$": {
                      "$ref": "#/$defs/widget"
                    }
                  },
                  "type": "object"
                }
              },
              "required": [
                "widgets"
              ],
              "type": "object"
            }
          },
          "type": "object"
        },
        "widgets": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/widget"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "widgets"
      ],
      "type": "object"
    }
  },
  "type": "object"
}
