# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Build artifacts — NEVER committed ────────────────────
# (built locally via the editor's Build button / tools/build script)
build/
dist/
*.exe
*.spec

# ── Editor / tooling state ───────────────────────────────
.editor_prefs.json
*.log
.claude/dispatch/
.claude/worktrees/
.claude/testruns/

# ── Graphify code graph — generated, rebuild with `graphify update .` ──
graphify-out/

# ── IDE / OS noise ───────────────────────────────────────
.vscode/
.idea/
Thumbs.db
.DS_Store

# Environment doctor output (tools/doctor.py)
doctor_report.txt

# ── Debug-mode run telemetry (game/debug) — generated per run ──
logs/

# ── High scores (game/core/highscores.py) — per-machine play history ──
scores/

# ── Audio volumes (game/core/audio_settings.py) — per-machine preferences ──
settings/
